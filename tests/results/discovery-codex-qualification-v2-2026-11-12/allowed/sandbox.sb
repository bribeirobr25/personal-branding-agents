(version 1)
(allow default)
(deny file-read*)
(allow file-read-metadata)
(allow file-read* (subpath "/private/tmp/discovery-call-bs6556bs") (subpath "/System") (subpath "/usr") (subpath "/bin") (subpath "/sbin") (subpath "/dev") (subpath "/Library/Apple") (subpath "/private/var/db") (subpath "/private/etc"))
(deny file-write*)
(allow file-write* (subpath "/private/tmp/discovery-call-bs6556bs") (literal "/dev/null"))
(deny network*)
(allow network-outbound (remote ip "127.0.0.1:59136"))
