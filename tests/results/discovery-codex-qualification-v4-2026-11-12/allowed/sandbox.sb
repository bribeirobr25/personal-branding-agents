(version 1)
(allow default)
(deny file-read*)
(allow file-read-metadata)
(allow file-read* (subpath "/private/tmp/discovery-call-c245j7g3") (subpath "/System") (subpath "/usr") (subpath "/bin") (subpath "/sbin") (subpath "/dev") (subpath "/Library/Apple") (subpath "/private/var/db") (subpath "/private/etc") (subpath "/private/preboot"))
(deny file-write*)
(allow file-write* (subpath "/private/tmp/discovery-call-c245j7g3") (literal "/dev/null"))
(deny network*)
(allow network-outbound (remote ip "localhost:59141"))
